# Optional MCP/Resend configuration. No real secrets belong in this file.
# Copy to .env.resend.local only when intentionally configuring real mail.
# Spring Boot launched by Maven does not load this file automatically.

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ALERT_MAIL_FROM=onboarding@resend.dev
ALERT_MAIL_RECIPIENTS=counselor@example.com
ALERT_RECIPIENT_ACCOUNTS=counselor@example.com=admin
MINDBRIDGE_PUBLIC_URL=http://localhost:8080

# start-mcp.ps1 creates a strong token if the setting is absent.
# For manual Compose startup, supply a random MCP_SERVICE_TOKEN of at least 32 characters.
# MCP_SERVICE_TOKEN=

# start-mcp.ps1 sets this to true after configuring the service token.
MCP_REMOTE_ENABLED=false

# Optional: callback scripts manage these local values when configuring a webhook.
RESEND_WEBHOOK_ID=
RESEND_WEBHOOK_URL=
